{
  "name": "reglookup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:all": "npm run build --prefix frontend && npm run build && node scripts/sync-dashboard-public.mjs",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:web": "npm run dev --prefix frontend",
    "railway": "railway",
    "railway:login": "railway login",
    "railway:whoami": "railway whoami",
    "railway:init": "railway init",
    "railway:link": "railway link",
    "railway:unlink": "railway unlink",
    "railway:up": "railway up",
    "railway:logs": "railway logs",
    "railway:open": "railway open",
    "railway:status": "railway status",
    "railway:vars": "railway variable",
    "railway:shell": "railway shell",
    "railway:run": "railway run",
    "railway:first-deploy": "bash scripts/railway-first-deploy.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^9.1.1",
    "bullmq": "^5.34.10",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "p-queue": "^8.1.0",
    "puppeteer-core": "^24.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@railway/cli": "^4.40.0",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
