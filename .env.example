PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# After listen(), warm both Puppeteer sessions in the background (recommended on Railway).
# Set to false to skip (faster deploy signal; first lookup pays cold-start cost).
WARMUP_ON_START=true

# Required in Docker/Linux if Chrome is not in default paths
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# CDP protocol timeout per Puppeteer call (ms). Raise if Repco/VicRoads throw Runtime.callFunctionOn timed out.
# PUPPETEER_PROTOCOL_TIMEOUT_MS=480000

# Optional: protect all routes except GET /health
# LOOKUP_API_KEY=your-secret
# Authorization: Bearer your-secret

# Optional: comma-separated origins for browser clients
# CORS_ORIGIN=https://your-app.vercel.app

# Without REDIS_URL: in-process p-queue on this instance only
# With REDIS_URL: add a second service running `node dist/worker.js` (same image)
REDIS_URL=

# Backpressure: reject when waiting+active jobs exceed this (Bull) or local queue backlog
QUEUE_MAX_DEPTH=100
SCRAPE_JOB_TIMEOUT_MS=120000

# One shared page per browser type; keep 1 unless you refactor for multiple tabs
VICROADS_CONCURRENCY=1
REPCO_CONCURRENCY=1

# Optional: slightly faster (riskier on slow networks)
# VICROADS_NAV_TIMEOUT_MS=5500
# VICROADS_INPUT_WAIT_MS=2200
# VICROADS_RESULT_WAIT_MS=2800
# REPCO_RESULT_WAIT_MS=7000
